{
  "name": "giggydev",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "dev": "vite playground --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:playground": "vite build playground",
    "preview": "vite preview playground --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run build:playground && npm run build:demo && npm run build:fixture && npm run test:build && playwright test",
    "predev": "npm run build",
    "build:demo": "vite build playground --mode demo --outDir demo-dist",
    "test:unit": "node scripts/build-tests.mjs && node --test tests/unit/capture.test.mjs tests/unit/vite.test.mjs tests/unit/source.test.mjs tests/unit/ai.test.mjs tests/unit/config-validation.test.mjs",
    "preview:demo": "vite preview playground --outDir demo-dist --host 127.0.0.1 --port 4188",
    "test:build": "node --test tests/build/bundle.test.mjs",
    "test:browser": "playwright test",
    "build:fixture": "vite build tests/fixtures/consumer --outDir ../../../.test-build/consumer --emptyOutDir"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.6.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
