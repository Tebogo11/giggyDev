{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "playground/src",
    "playground/vite.config.ts",
    "tests",
    "playwright.config.ts",
    "playwright.next.config.ts"
  ]
}
